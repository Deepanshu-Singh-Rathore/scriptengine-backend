# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dyqtjusjewimrmoetxet.supabase.co:5432/postgres

# Individual database connection parameters (alternative to DATABASE_URL)
POSTGRES_HOST=db.dyqtjusjewimrmoetxet.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]

# Google Gemini API
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]

# GitHub Repository (for storing approved scripts)
GITHUB_REPO_PATH=./approved-scripts
GITHUB_REPO_URL=

# Search Configuration
SIMILARITY_THRESHOLD=0.8
EMBEDDING_DIMENSION=1536

# Preview Configuration
MAX_UPLOAD_SIZE_MB=50
PREVIEW_SAMPLE_SIZE=100
PREVIEW_TIMEOUT_SECONDS=5
